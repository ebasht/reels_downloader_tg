BOT=123456789:telegram-bot-token
DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=verify-full
BOT_DEBUG=false

# Downloads
MAX_CONCURRENT_DOWNLOADS=3
MAX_QUEUE=30
MAX_VIDEO_DURATION=10m
DOWNLOAD_TIMEOUT=3m

# Rate limits: links per RATE_WINDOW
USER_RATE_LIMIT=5
CHAT_RATE_LIMIT=20
RATE_WINDOW=1m
